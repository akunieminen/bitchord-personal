@@ -0,0 +1,95 @@
+package com.music.bitchord.ui.screens
+
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.automirrored.rounded.QueueMusic
+import androidx.compose.material.icons.rounded.CloudDownload
+import androidx.compose.material.icons.rounded.HourglassTop
+import androidx.compose.material.icons.rounded.Pause
+import androidx.compose.material.icons.rounded.Speed
+import androidx.compose.material.icons.rounded.Waves
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Switch
+import androidx.compose.material3.SwitchDefaults
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.music.bitchord.data.settings.ForkSettings
+import java.util.Locale
+
+/** The personal fork's switches — see [ForkSettings]. English only, on purpose: no strings.xml to conflict on. */
+@Composable
+internal fun ForkTweaksGroup() {
+    SettingsGroup(
+        header = "Fork tweaks",
+        footer = "Personal build. These change how hi-res copies from addons are found and swapped in.",
+    ) {
+        ToggleRow(
+            Icons.Rounded.CloudDownload,
+            "Addon lookahead",
+            "Find the next song's hi-res copy while this one plays",
+            ForkSettings.addonLookahead,
+        )
+        RowDivider()
+        ToggleRow(
+            Icons.AutoMirrored.Rounded.QueueMusic,
+            "Look two songs ahead",
+            "Also find the song after next, so skips and mixes start hi-res",
+            ForkSettings.pinTwoAhead,
+        )
+        RowDivider()
+        ToggleRow(
+            Icons.Rounded.Speed,
+            "Fast read-ahead",
+            "Start downloading the next song 2s into this one instead of 8s",
+            ForkSettings.fastReadAhead,
+        )
+        RowDivider()
+        ToggleRow(
+            Icons.Rounded.Pause,
+            "Read ahead while paused",
+            "Keep downloading the next song when playback is paused",
+            ForkSettings.prefetchWhilePaused,
+        )
+        RowDivider()
+        ToggleRow(
+            Icons.Rounded.Waves,
+            "No swap after a mix",
+            "A song that crossfaded in keeps its stream instead of cutting to a better copy",
+            ForkSettings.noUpgradeAfterBlend,
+        )
+        RowDivider()
+        val headStart by ForkSettings.headStartMs.collectAsStateWithLifecycle()
+        SliderRow(
+            icon = Icons.Rounded.HourglassTop,
+            title = "Wait for hi-res",
+            subtitle = "How long a tapped song waits for the addon before starting on YouTube",
+            value = if (headStart == 0L) "Off" else String.format(Locale.ROOT, "%.1fs", headStart / 1000f),
+            sliderValue = headStart / 1000f,
+            onSliderValue = { ForkSettings.setHeadStartMs((it * 2).toInt() * 500L) },
+            valueRange = 0f..8f,
+            steps = 15,
+        )
+    }
+}
+
+@Composable
+private fun ToggleRow(icon: ImageVector, title: String, subtitle: String, toggle: ForkSettings.Toggle) {
+    val on by toggle.flow.collectAsStateWithLifecycle()
+    SettingsRow(
+        icon = icon,
+        title = title,
+        subtitle = subtitle,
+        trailing = {
+            Switch(
+                checked = on,
+                onCheckedChange = toggle::set,
+                colors = SwitchDefaults.colors(
+                    checkedTrackColor = MaterialTheme.colorScheme.primary,
+                    checkedBorderColor = MaterialTheme.colorScheme.primary,
+                ),
+            )
+        },
+        onClick = { toggle.set(!on) },
+    )
+}
