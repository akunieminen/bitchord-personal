+package com.music.bitchord.data.settings
+
+import android.content.Context
+import android.content.SharedPreferences
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/**
+ * The personal fork's own switches, kept out of [AppSettings] so the fork's
+ * patches stay small against upstream. Not part of Export data.
+ */
+object ForkSettings {
+
+    private lateinit var prefs: SharedPreferences
+
+    class Toggle internal constructor(private val key: String, private val default: Boolean) {
+        val flow = MutableStateFlow(default)
+        val value: Boolean get() = flow.value
+
+        internal fun load() {
+            flow.value = prefs.getBoolean(key, default)
+        }
+
+        fun set(on: Boolean) {
+            flow.value = on
+            prefs.edit().putBoolean(key, on).apply()
+        }
+    }
+
+    /** Addon sources join JioSaavn in being asked about the next track ahead of time. */
+    val addonLookahead = Toggle("addon_lookahead", true)
+
+    /** The track after the next one is pinned too, so a skip or a crossfade's early preload finds it. */
+    val pinTwoAhead = Toggle("pin_two_ahead", true)
+
+    /** Read-ahead starts 2s into a track instead of 8s. */
+    val fastReadAhead = Toggle("fast_read_ahead", true)
+
+    /** A pause leaves read-ahead running instead of cancelling it. */
+    val prefetchWhilePaused = Toggle("prefetch_while_paused", true)
+
+    /** A track that arrived through a crossfade or Automix keeps its stream for that play. */
+    val noUpgradeAfterBlend = Toggle("no_upgrade_after_blend", true)
+
+    /**
+     * How long an unpinned track waits for a higher-ranked source before
+     * taking YouTube's stream. 0 is upstream's plain race.
+     */
+    val headStartMs = MutableStateFlow(DEFAULT_HEAD_START_MS)
+
+    fun setHeadStartMs(ms: Long) {
+        headStartMs.value = ms
+        prefs.edit().putLong(KEY_HEAD_START_MS, ms).apply()
+    }
+
+    fun init(context: Context) {
+        prefs = context.getSharedPreferences("bitchord_fork", Context.MODE_PRIVATE)
+        listOf(addonLookahead, pinTwoAhead, fastReadAhead, prefetchWhilePaused, noUpgradeAfterBlend)
+            .forEach { it.load() }
+        headStartMs.value = prefs.getLong(KEY_HEAD_START_MS, DEFAULT_HEAD_START_MS)
+    }
+
+    // ponytail: measured against one bridge (search 2.6s + stream 1.2s); tune on the slider.
+    private const val DEFAULT_HEAD_START_MS = 4_000L
+    private const val KEY_HEAD_START_MS = "head_start_ms"
+}
diff --git a/app/src/main/java/com/music/bitchord/ui/screens/ForkTweaksGroup.kt b/app/src/main/java/com/music/bitchord/ui/screens/ForkTweaksGroup.kt
