From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 17:21:51 +0300
Subject: [PATCH 58/61] fix(autoplay): a load-more request that arrives while
 the per-track top-up runs waits for it instead of being dropped (the queue
 list only asks once per arrival)

---
 .../com/music/bitchord/playback/PlaybackService.kt     | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
index 1575268..449061c 100644
--- a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
+++ b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
@@ -3002,11 +3002,15 @@ class PlaybackService : MediaLibraryService() {
         val party = ListenTogether.state.value
         if (party.inParty || !autoplayEnabled(party) || exoPlayer.repeatMode == Player.REPEAT_MODE_ALL) return
         if (boundedContextWindow != null && !boundedAutoplayEligible(exoPlayer)) return
-        if (moreAutoplayJob?.isActive == true || autoplayLoadJob?.isActive == true) return
+        if (moreAutoplayJob?.isActive == true) return
         if (exoPlayer.mediaItemCount == 0) return
-        val seed = exoPlayer.getMediaItemAt(exoPlayer.mediaItemCount - 1).toSong()
         moreAutoplayJob = scope.launch {
-            val queued = (0 until exoPlayer.mediaItemCount).map { exoPlayer.getMediaItemAt(it).toSong() }
+            // Fork: queued behind the per-track top-up rather than dropped — the queue list asks
+            // only once per arrival at its end. Seeded after it, from what is last by then.
+            while (true) autoplayLoadJob?.takeIf { it.isActive }?.join() ?: break
+            val start = player?.takeIf { it.mediaItemCount > 0 } ?: return@launch
+            val seed = start.getMediaItemAt(start.mediaItemCount - 1).toSong()
+            val queued = (0 until start.mediaItemCount).map { start.getMediaItemAt(it).toSong() }
             val existing = if (AppSettings.dontRepeatSuggestions.value) queued + sessionSongHistory else queued
             val more = loadAutoplayTracks(existing, seed, MAX_QUEUED_AUTOPLAY).getOrElse {
                 TrackLog.w("BitChord", "more AutoPlay failed: ${it.message}", about = seed.videoId)
