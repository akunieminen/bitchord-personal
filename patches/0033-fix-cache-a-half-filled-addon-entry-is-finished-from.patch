diff --git a/app/src/main/java/com/music/bitchord/playback/StreamChoice.kt b/app/src/main/java/com/music/bitchord/playback/StreamChoice.kt
index 70f3188..5699e58 100644
--- a/app/src/main/java/com/music/bitchord/playback/StreamChoice.kt
+++ b/app/src/main/java/com/music/bitchord/playback/StreamChoice.kt
@@ -60,13 +60,18 @@ object StreamChoice {
      */
     fun of(videoId: String): SourceStream? {
         val choice = chosen[videoId] ?: return null
-        if (SystemClock.elapsedRealtime() - choice.at > TTL_MS) {
-            chosen.remove(videoId)
-            return null
-        }
-        return choice.stream
+        // Fork: an expired choice is kept (bounded by [remember]'s pruning), see [lapsed].
+        return choice.stream.takeIf { SystemClock.elapsedRealtime() - choice.at <= TTL_MS }
     }
 
+    /**
+     * Fork: the substitute last chosen for [videoId], however long ago. Only for
+     * finishing an entry that stream already started filling: a fresh race there
+     * after a long pause could append another server's file. A URL that died in
+     * the meantime fails as a 403 into recovery instead of splicing.
+     */
+    fun lapsed(videoId: String): SourceStream? = chosen[videoId]?.takeIf { it.substituted }?.stream
+
     /**
      * Records [stream] as the one copy of [videoId] this play is reading.
      *
