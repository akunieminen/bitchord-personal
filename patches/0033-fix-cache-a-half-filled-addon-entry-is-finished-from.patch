@@ -1542,7 +1542,8 @@ class PlaybackService : MediaLibraryService() {
             // [StreamChoice].
             // Fork: an entry already holding YouTube bytes is finished from YouTube, pinned or not.
             val youTubeOnDisk = AudioCache.holdsYouTubeBytes(dataSpec)
-            StreamChoice.of(videoId)?.takeUnless { youTubeOnDisk && StreamChoice.isSubstitute(videoId) }?.let { serving ->
+            // Fork: and a half-filled substitute's entry from its own stream, its pin lapsed or not.
+            AudioCache.pinFor(videoId, dataSpec)?.takeUnless { youTubeOnDisk && StreamChoice.isSubstitute(videoId) }?.let { serving ->
                 // What the stream claims to be, restated on every open rather
                 // than only on the one that chose it.
