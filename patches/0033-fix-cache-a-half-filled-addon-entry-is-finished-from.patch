Subject: [PATCH 33/61] fix(cache): a half-filled addon entry is finished from
 its own stream after its 15-min pin lapses (pause, long tracks), not from a
 fresh race that can splice another file in

---
 .../com/music/bitchord/playback/AudioCache.kt | 25 ++++++++++++++++++-
 .../bitchord/playback/PlaybackService.kt      |  3 ++-
 .../music/bitchord/playback/StreamChoice.kt   | 15 +++++++----
 3 files changed, 36 insertions(+), 7 deletions(-)

diff --git a/app/src/main/java/com/music/bitchord/playback/AudioCache.kt b/app/src/main/java/com/music/bitchord/playback/AudioCache.kt
index 0de92fb..c1db7c6 100644
--- a/app/src/main/java/com/music/bitchord/playback/AudioCache.kt
+++ b/app/src/main/java/com/music/bitchord/playback/AudioCache.kt
@@ -1422,7 +1422,7 @@ object AudioCache {
         if (StreamChoice.substitutesRefused(id)) return false
         // Nor is a track the quick sources just didn't have asked about again on every queue change.
         if (recentlyMissed(id)) return false
-        StreamChoice.of(id)?.let { pinned ->
+        pinFor(id, DataSpec(Uri.parse("bitchord://watch?v=$id")))?.let { pinned ->
             if (!StreamChoice.isSubstitute(id)) return false
             // Re-stamped, so a pin made a track early doesn't age out before
             // its own fade arms. Ceiling: the URL is then trusted up to a track
@@ -1459,6 +1459,29 @@ object AudioCache {
         return true
     }
 
+    /**
+     * Fork: the pin a resolve or read-ahead of [id] must honour, for the entry [spec] reads.
+     * A substitute's pin outlives [StreamChoice]'s TTL while that entry holds (or is filling
+     * with) a substitute's bytes — a long pause or two long tracks age it out, and a fresh race
+     * there finished the file from another server's (two files, one decoder).
+     */
+    fun pinFor(id: String, spec: DataSpec): com.music.bitchord.data.sources.SourceStream? {
+        StreamChoice.of(id)?.let { return it }
+        if (!::cache.isInitialized) return null
+        val filler = fillerOf(spec.key ?: keyFactory.buildCacheKey(spec))
+        if (filler == null || filler == Origin.YOUTUBE.name) return null
+        return StreamChoice.lapsed(id)?.also { StreamChoice.remember(id, it, substituted = true) }
+    }
+
+    /**
+     * Fork: whose bytes the entry [key] holds or is being filled with, or null when it is empty.
+     * Read from the tag [recordServed] writes before the first byte: an entry's first 5 MB
+     * fragment is not a span until it is committed, so a span check sees a track still being
+     * streamed into it as empty.
+     */
+    private fun fillerOf(key: String): String? =
+        runCatching { cache.getContentMetadata(key).get(META_ORIGIN, null as String?) }.getOrNull()
+
     /** Fork: whether the entry [spec] reads already holds YouTube bytes; finishing it from another file splices two containers. */
     fun holdsYouTubeBytes(spec: DataSpec): Boolean = ::cache.isInitialized && runCatching {
         val key = spec.key ?: keyFactory.buildCacheKey(spec)
diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
