From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 15:24:23 +0300
Subject: [PATCH 31/61] fork: tracks served from a pin still get YouTube's
 loudness figure (one resolve per minute for the current and next track), so
 normalization levels them too

---
 .../bitchord/playback/PlaybackService.kt      | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
index 12eace7..25c52c5 100644
--- a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
+++ b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
@@ -1169,6 +1169,7 @@ class PlaybackService : MediaLibraryService() {
             // A queue edit can change what follows gaplessly, and the loudness
             // stage switches to that track on its own at the boundary.
             activeLoudness().nextMediaId = nextMediaIdOf(exoPlayer)
+            ensureLoudnessFigure(nextMediaIdOf(exoPlayer))
             if (reason == Player.TIMELINE_CHANGE_REASON_PLAYLIST_CHANGED) {
                 speakers.onLocalQueueChanged()
                 saveQueueSnapshot(exoPlayer)
@@ -7310,6 +7311,29 @@ class PlaybackService : MediaLibraryService() {
         val exoPlayer = player ?: return
         activeLoudness().track(mediaId, nextMediaIdOf(exoPlayer))
         publishLoudnessFor(mediaId)
+        ensureLoudnessFigure(mediaId)
+        ensureLoudnessFigure(nextMediaIdOf(exoPlayer))
+    }
+
+    /** Fork: when each id last had a YouTube resolve asked just for its loudness figure. */
+    private val loudnessAskedAt = ConcurrentHashMap<String, Long>()
+
+    /**
+     * Fork: the normalization figure comes with YouTube's player response, and a track
+     * served from a pin never asks YouTube — so it played at full gain while its
+     * neighbours were levelled. Resolve YouTube once (per minute) just for the figure;
+     * [LoudnessProcessor] glides the gain in the moment it lands.
+     */
+    private fun ensureLoudnessFigure(mediaId: String?) {
+        val id = mediaId?.takeIf { it.isNotBlank() && SourceRegistry.parseTrackKey(it) == null } ?: return
+        if (!AppSettings.loudnessNormalization.value || StreamResolver.loudnessDbFor(id) != null) return
+        val now = SystemClock.elapsedRealtime()
+        if (loudnessAskedAt[id]?.let { now - it < LOUDNESS_ASK_INTERVAL_MS } == true) return
+        loudnessAskedAt[id] = now
+        scope.launch {
+            runCatching { withContext(Dispatchers.IO) { StreamResolver.resolve(id) } }
+            if (player?.currentMediaItem?.mediaId == id) publishLoudnessFor(id)
+        }
     }
 
     /** The track [exoPlayer] will move onto gaplessly, if any. */
@@ -9444,6 +9468,8 @@ class PlaybackService : MediaLibraryService() {
         const val UPGRADE_ALIGN_TIMEOUT_MS = 4_000L
         /** Fork: how close the two copies must be before the upgrade fades, and how long to try. */
         const val ALIGN_TOLERANCE_MS = 20L
+        /** Fork: at most one loudness-only YouTube resolve per track per minute. */
+        const val LOUDNESS_ASK_INTERVAL_MS = 60_000L
         const val ALIGN_SETTLE_MS = 600L
         const val ALIGN_BUDGET_MS = 6_000L
 
