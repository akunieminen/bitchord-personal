Subject: [PATCH 13/61] fork: TrackLog reaches logcat in release builds

---
 .../com/music/bitchord/data/innertube/AndroidStreamHooks.kt    | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/music/bitchord/data/innertube/AndroidStreamHooks.kt b/app/src/main/java/com/music/bitchord/data/innertube/AndroidStreamHooks.kt
index 4c213ef..41c29ec 100644
--- a/app/src/main/java/com/music/bitchord/data/innertube/AndroidStreamHooks.kt
+++ b/app/src/main/java/com/music/bitchord/data/innertube/AndroidStreamHooks.kt
@@ -24,7 +24,8 @@ object AndroidStreamHooks {
     fun installEarly() {
         MonotonicClock.nowMs = SystemClock::elapsedRealtime
         TrackLog.echo = { level, tag, message, error ->
-            if (BuildConfig.DEBUG) {
+            // Fork: release builds echo too, so lookahead and swaps can be read over adb.
+            if (true) {
                 when (level) {
                     'D' -> Log.d(tag, message, error)
                     'I' -> Log.i(tag, message, error)
