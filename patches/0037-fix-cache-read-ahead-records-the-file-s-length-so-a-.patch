From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 17:16:04 +0300
Subject: [PATCH 37/61] fix(cache): read-ahead records the file's length, so a
 fully read-ahead track counts as complete, seeks without a SEEKTABLE, and its
 last read doesn't go back to the network

---
 .../java/com/music/bitchord/playback/AudioCache.kt   | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/com/music/bitchord/playback/AudioCache.kt b/app/src/main/java/com/music/bitchord/playback/AudioCache.kt
index ca997b4..e3a3ae8 100644
--- a/app/src/main/java/com/music/bitchord/playback/AudioCache.kt
+++ b/app/src/main/java/com/music/bitchord/playback/AudioCache.kt
@@ -1578,6 +1578,10 @@ object AudioCache {
             runCatching { StreamResolver.contentLength(videoId) }.getOrNull()
         } ?: return false
         val key = readAheadKey(videoId)
+        // Fork: bounded writes never store it, and the player's open needs it (seeking a FLAC
+        // without a SEEKTABLE, a whole entry counting as complete, no network read at its end).
+        // Only over this stream's own bytes: on an empty entry a later race may serve another file.
+        if (cache.getCachedSpans(key).isNotEmpty()) recordContentLength(key, total)
 
         var position = 0L
         while (position < total) {
@@ -1999,15 +2003,15 @@ object AudioCache {
      * Cheap because [StreamResolver] has the number already: it was read to
      * resolve the stream this fetch just pulled from.
      */
-    private fun recordContentLength(videoId: String, total: Long) {
-        if (ContentMetadata.getContentLength(cache.getContentMetadata(videoId)) > 0) return
+    private fun recordContentLength(key: String, total: Long) {
+        if (ContentMetadata.getContentLength(cache.getContentMetadata(key)) > 0) return
         if (total <= 0) return
         runCatching {
             cache.applyContentMetadataMutations(
-                videoId,
+                key,
                 ContentMetadataMutations().apply { ContentMetadataMutations.setContentLength(this, total) },
             )
-        }.onFailure { TrackLog.d(TAG, "could not record length for $videoId: ${it.message}", about = videoId) }
+        }.onFailure { TrackLog.d(TAG, "could not record length for $key: ${it.message}") }
     }
 
     /**
