From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 10:28:52 +0300
Subject: [PATCH 12/22] fork: in-app updates come from
 akunieminen/bitchord-personal

---
 app/build.gradle.kts                                          | 4 +++-
 app/src/main/java/com/music/bitchord/data/AppUpdateChecker.kt | 2 +-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 6193f11..ca30684 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -68,7 +68,9 @@ android {
         minSdk = 26
         targetSdk = 36
         versionCode = rootProject.extra["bitchordVersionCode"] as Int
-        versionName = rootProject.extra["bitchordVersionName"] as String
+        // Fork: CI appends its build number (1.8.1 -> 1.8.1.7) so the in-app updater sees each fork build as newer.
+        versionName = (rootProject.extra["bitchordVersionName"] as String) +
+            (findProperty("bitchord.forkRevision")?.let { ".$it" } ?: "")
 
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
 
diff --git a/app/src/main/java/com/music/bitchord/data/AppUpdateChecker.kt b/app/src/main/java/com/music/bitchord/data/AppUpdateChecker.kt
index 76bcb13..78e4074 100644
--- a/app/src/main/java/com/music/bitchord/data/AppUpdateChecker.kt
+++ b/app/src/main/java/com/music/bitchord/data/AppUpdateChecker.kt
@@ -43,7 +43,7 @@ object AppUpdateChecker {
     private const val CACHE_SUBDIR = "updates"
 
     private const val LATEST_RELEASE_URL =
-        "https://api.github.com/repos/kushagrasinghx/BitChord/releases/latest"
+        "https://api.github.com/repos/akunieminen/bitchord-personal/releases/latest" // fork: own builds
 
     private val json = Json { ignoreUnknownKeys = true }
 
