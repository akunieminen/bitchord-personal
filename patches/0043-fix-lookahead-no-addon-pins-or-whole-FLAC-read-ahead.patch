From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 17:17:26 +0300
Subject: [PATCH 43/61] fix(lookahead): no addon pins or whole-FLAC read-ahead
 for local, SMB and WebDAV tracks, which play from their own file

---
 .../main/java/com/music/bitchord/playback/PlaybackService.kt  | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
index e4354fe..c4f6485 100644
--- a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
+++ b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
@@ -6517,7 +6517,9 @@ class PlaybackService : MediaLibraryService() {
 
         fun warm(songs: List<Song>) {
             AudioCache.prefetchQueue(
-                songs.map { song ->
+                // Fork: local, SMB and WebDAV tracks play from localUri, below the cache — reading
+                // ahead for them only pinned an addon and pulled a whole FLAC nothing reads.
+                songs.filter { it.localUri == null }.map { song ->
                     // The title, artist and runtime the item was built with —
                     // see [Song.toMediaItem]. Read from the queued item because
                     // read-ahead has no other way to reach this metadata.
