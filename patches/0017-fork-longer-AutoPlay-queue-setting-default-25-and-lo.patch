 /** Session actions exposed to Android Auto for the track that is playing. */
 const val ACTION_START_STATION = "com.music.bitchord.action.START_STATION"
@@ -2927,6 +2929,38 @@ class PlaybackService : MediaLibraryService() {
      * replaced by a new one appended after the ones still waiting instead of
      * everything arriving in one burst at the end of the queue.
      */
+    private var moreAutoplayJob: Job? = null
+
+    /**
+     * Fork: the queue list reached its end — append another AutoPlay batch seeded
+     * from the last queued track, so the radio keeps going the way YouTube
+     * Music's does. Past [MAX_QUEUED_AUTOPLAY] on purpose; the top-up below only
+     * ever adds, so nothing trims it back. Not in a party, whose queue is the server's.
+     */
+    private fun loadMoreAutoplay() {
+        val exoPlayer = player ?: return
+        val party = ListenTogether.state.value
+        if (party.inParty || !autoplayEnabled(party) || exoPlayer.repeatMode == Player.REPEAT_MODE_ALL) return
+        if (boundedContextWindow != null && !boundedAutoplayEligible(exoPlayer)) return
+        if (moreAutoplayJob?.isActive == true || autoplayLoadJob?.isActive == true) return
+        if (exoPlayer.mediaItemCount == 0) return
+        val seed = exoPlayer.getMediaItemAt(exoPlayer.mediaItemCount - 1).toSong()
+        moreAutoplayJob = scope.launch {
+            val queued = (0 until exoPlayer.mediaItemCount).map { exoPlayer.getMediaItemAt(it).toSong() }
+            val existing = if (AppSettings.dontRepeatSuggestions.value) queued + sessionSongHistory else queued
+            val more = loadAutoplayTracks(existing, seed, MAX_QUEUED_AUTOPLAY).getOrElse {
+                TrackLog.w("BitChord", "more AutoPlay failed: ${it.message}", about = seed.videoId)
+                return@launch
+            }
+            val latest = player ?: return@launch
+            val now = (0 until latest.mediaItemCount).map { latest.getMediaItemAt(it).toSong() }
+            val fresh = more.filterNot { song -> now.any { QueueBuilder.isSameRecording(it, song) } }
+            if (fresh.isNotEmpty()) latest.addMediaItems(fresh.map { it.toMediaItem() })
+            if (AppSettings.dontRepeatSuggestions.value) sessionSongHistory += fresh
+            TrackLog.d("BitChord", "AutoPlay extended by ${fresh.size} from '${seed.title}'", about = seed.videoId)
+        }
+    }
+
     private fun loadAutoplayForCurrentTrack() {
