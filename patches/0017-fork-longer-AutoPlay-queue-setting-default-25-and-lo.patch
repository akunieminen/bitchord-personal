+package com.music.bitchord.ui.player
+
+/**
+ * Fork: called when the queue list is scrolled to its last rows, so the app can
+ * ask for more AutoPlay the way YouTube Music does. A no-op until a platform sets it.
+ */
+object QueueEndHook {
+    var onNearEnd: () -> Unit = {}
+}
