From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 15:13:28 +0300
Subject: [PATCH 30/61] fork: lookahead and the tapped-track race skip manifest
 (DASH/HLS) answers and take the next addon's plain file, so they start in
 hi-res

---
 .../music/bitchord/data/sources/SourceResolver.kt    | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/com/music/bitchord/data/sources/SourceResolver.kt b/app/src/main/java/com/music/bitchord/data/sources/SourceResolver.kt
index f4e382c..dac1a81 100644
--- a/app/src/main/java/com/music/bitchord/data/sources/SourceResolver.kt
+++ b/app/src/main/java/com/music/bitchord/data/sources/SourceResolver.kt
@@ -8,6 +8,7 @@ import com.music.bitchord.data.settings.AppSettings
 import com.music.bitchord.data.settings.AudioQuality
 import com.music.bitchord.data.settings.DownloadQuality
 import com.music.bitchord.data.settings.ForkSettings
+import com.music.bitchord.playback.StreamContainer
 import kotlinx.coroutines.CancellationException
 import kotlinx.coroutines.Deferred
 import kotlinx.coroutines.async
@@ -257,7 +258,11 @@ object SourceResolver {
         val active = SourceRegistry.activeForPlayback()
         val youtube = active.firstOrNull { it.kind == SourceKind.YOUTUBE } ?: return null
         val request = requestForNow()
-        val (source, stream) = bestAcross(rankedAbove(youtube.configId, active), target, request)
+        // Fork: a manifest (DASH/HLS) can't start a track that was built progressive; take
+        // the next source's plain file instead. A manifest-only answer still plays via the upgrade.
+        val (source, stream) = bestAcross(rankedAbove(youtube.configId, active), target, request) { _, s ->
+            !StreamContainer.isManifest(s.url)
+        }
             ?: return null
         // Says what was found, not what the caller will do with it. This
         // line used to read "substituted" unconditionally, including for
@@ -330,7 +335,10 @@ object SourceResolver {
             it.kind.worthPrefetching || (it.kind == SourceKind.ADDON && ForkSettings.addonLookahead.value)
         }
         if (quick.isEmpty()) return null
-        val (source, stream) = bestAcross(quick, target, requestForNow()) ?: return null
+        // Fork: no manifests — a pin is played from its first byte by a progressive source.
+        val (source, stream) = bestAcross(quick, target, requestForNow()) { _, s ->
+            !StreamContainer.isManifest(s.url)
+        } ?: return null
         TrackLog.d(
             TAG,
             "warmed: '${target.title}' from ${source.displayName} at ${stream.format.summary}",
