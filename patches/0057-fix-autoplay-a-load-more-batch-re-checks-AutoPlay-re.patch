From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akunieminen <aku.nieminen1@gmail.com>
Date: Tue, 20 Oct 2026 17:21:11 +0300
Subject: [PATCH 57/61] fix(autoplay): a load-more batch re-checks AutoPlay,
 repeat, party and the queue when it lands, so it can't put 25 suggestions
 back after AutoPlay was switched off or onto a new queue

---
 .../com/music/bitchord/playback/PlaybackService.kt     | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
index b34b147..1575268 100644
--- a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
+++ b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
@@ -3019,6 +3019,16 @@ class PlaybackService : MediaLibraryService() {
             }
             // A source crossfade may have swapped players meanwhile.
             val latest = player ?: return@launch
+            // Anything may have changed during the fetch: AutoPlay switched off, repeat-all on,
+            // a party joined, a new queue (its seed gone). Before the history write, so a dropped
+            // batch isn't written off as already suggested.
+            val p = ListenTogether.state.value
+            if (p.inParty || !autoplayEnabled(p) || latest.repeatMode == Player.REPEAT_MODE_ALL ||
+                (boundedContextWindow != null && !boundedAutoplayEligible(latest)) ||
+                (0 until latest.mediaItemCount).none { latest.getMediaItemAt(it).mediaId == seed.videoId }
+            ) {
+                return@launch
+            }
             if (items.isNotEmpty()) latest.addMediaItems(items)
             if (AppSettings.dontRepeatSuggestions.value) sessionSongHistory += fresh
             TrackLog.d("BitChord", "AutoPlay extended by ${fresh.size} from '${seed.title}'", about = seed.videoId)
